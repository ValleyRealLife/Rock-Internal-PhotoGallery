{%- comment -%} Inputs {%- endcomment -%}
{%- assign fileTypeId = ConfigurationRigging.FileTypeId -%}
{%- assign keywordTypeId = ConfigurationRigging.KeywordsDefinedTypeId -%}
{%- assign pageSize = ConfigurationRigging.PageSize | AsInteger | Default:48 -%}
{%- assign thumbWidth = ConfigurationRigging.ThumbWidth | Default:480 -%}
{%- assign stripWidth = ConfigurationRigging.StripWidth | Default:160 -%}
{%- assign previewWidth = ConfigurationRigging.PreviewWidth | Default:1600 -%}
{%- assign lowResMaxEdge = 500 -%}
{%- assign highResMinEdge = 1921 -%}
{%- assign page = QueryString.page | AsInteger | Default:1 -%}
{%- if page < 1 -%}{%- assign page = 1 -%}{%- endif -%}
{%- assign q = QueryString.q | Trim | Default:'' -%}
{%- assign keyword = QueryString.keyword | Trim | Default:'' -%}
{%- assign audience = QueryString.audience | Trim | Default:'' -%}
{%- assign sort = QueryString.sort | Default:'newest' -%}
{%- assign view = QueryString.view | Default:'grid' -%}
{%- if view != 'filmstrip' -%}{%- assign view = 'grid' -%}{%- endif -%}
{%- assign deleted = QueryString.deleted | AsBoolean -%}
{%- assign deletedFlag = 0 -%}{%- if deleted -%}{%- assign deletedFlag = 1 -%}{%- endif -%}
{%- assign offset = page | Minus:1 | Times:pageSize -%}
{%- assign take = pageSize | Plus:1 -%}

{%- comment -%} Query: one extra row tells us whether another page exists {%- endcomment -%}
{%- sql filetypeid:'{{ fileTypeId }}' keywordtypeid:'{{ keywordTypeId }}' q:'{{ q }}' keyword:'{{ keyword }}' audience:'{{ audience }}' sort:'{{ sort }}' deleted:'{{ deletedFlag }}' offset:'{{ offset }}' take:'{{ take }}' -%}
DECLARE @BinaryFileEntityTypeId int = (SELECT Id FROM EntityType WHERE Name = 'Rock.Model.BinaryFile');
DECLARE @KeywordsAttributeId int = (
    SELECT Id FROM Attribute
    WHERE EntityTypeId = @BinaryFileEntityTypeId AND [Key] = 'Keywords'
      AND EntityTypeQualifierColumn = 'BinaryFileTypeId'
      AND EntityTypeQualifierValue = CAST(@filetypeid AS varchar(10)));
DECLARE @AudienceAttributeId int = (
    SELECT Id FROM Attribute
    WHERE EntityTypeId = @BinaryFileEntityTypeId AND [Key] = 'Audience'
      AND EntityTypeQualifierColumn = 'BinaryFileTypeId'
      AND EntityTypeQualifierValue = CAST(@filetypeid AS varchar(10)));

SELECT bf.Id, bf.Guid, bf.FileName, bf.Description, bf.Width, bf.Height, bf.CreatedDateTime, bf.ModifiedDateTime,
       CASE WHEN ISNULL(bf.Width, 0) >= ISNULL(bf.Height, 0) THEN ISNULL(bf.Width, 0) ELSE ISNULL(bf.Height, 0) END AS LongEdge
FROM BinaryFile bf
LEFT JOIN AttributeValue kw ON kw.AttributeId = @KeywordsAttributeId AND kw.EntityId = bf.Id
LEFT JOIN AttributeValue aud ON aud.AttributeId = @AudienceAttributeId AND aud.EntityId = bf.Id
WHERE bf.BinaryFileTypeId = @filetypeid
  AND bf.IsTemporary = CAST(@deleted AS bit)
  AND (@audience = '' OR ',' + ISNULL(aud.Value, '') + ',' LIKE '%,' + @audience + ',%')
  AND (@keyword = '' OR ',' + ISNULL(kw.Value, '') + ',' LIKE '%,' + @keyword + ',%')
  AND (@q = ''
       OR bf.FileName LIKE '%' + @q + '%'
       OR bf.Description LIKE '%' + @q + '%'
       OR EXISTS (
           SELECT 1 FROM DefinedValue dv
           WHERE dv.DefinedTypeId = @keywordtypeid
             AND dv.Value LIKE '%' + @q + '%'
             AND ',' + ISNULL(kw.Value, '') + ',' LIKE '%,' + CAST(dv.Guid AS varchar(36)) + ',%'))
ORDER BY
  CASE WHEN @deleted = '1' THEN bf.ModifiedDateTime END DESC,
  CASE WHEN @sort = 'name' THEN bf.FileName END ASC,
  CASE WHEN @sort = 'oldest' THEN bf.CreatedDateTime END ASC,
  bf.CreatedDateTime DESC, bf.Id DESC
OFFSET CAST(@offset AS int) ROWS FETCH NEXT CAST(@take AS int) ROWS ONLY;
{%- endsql -%}

{%- assign rowCount = results | Size -%}
{%- assign hasMore = false -%}
{%- if rowCount > pageSize -%}{%- assign hasMore = true -%}{%- endif -%}
{%- capture nextUrl -%}^/web-theme-images/browse?page={{ page | Plus:1 }}&view={{ view }}&q={{ q | EscapeDataString }}&keyword={{ keyword | EscapeDataString }}&audience={{ audience | EscapeDataString }}&sort={{ sort | EscapeDataString }}&deleted={{ deletedFlag }}{%- endcapture -%}
{%- capture sentinel -%}{%- if hasMore -%}<div class="wti-more" hx-get="{{ nextUrl }}" hx-trigger="intersect once" hx-swap="outerHTML"></div>{%- endif -%}{%- endcapture -%}

{%- comment -%} Markup {%- endcomment -%}
{%- if page == 1 and rowCount == 0 -%}
<p class="wti-empty">{% if deleted %}No recently deleted images.{% else %}No images match.{% endif %}</p>

{%- elsif view == 'filmstrip' -%}
{%- capture thumbs -%}
{%- for row in results limit:pageSize -%}
{%- assign longEdge = row.LongEdge | AsInteger | Default:0 -%}
<div class="wti-thumb-wrap">
<button type="button" class="wti-thumb{% if page == 1 and forloop.first %} is-active{% endif %}"
        data-guid="{{ row.Guid }}"
        data-width="{{ row.Width }}"
        data-height="{{ row.Height }}"
        data-stage="/GetImage.ashx?guid={{ row.Guid }}&w={{ previewWidth }}"
        data-name="{{ row.FileName | Escape }}">
    <img src="/GetImage.ashx?guid={{ row.Guid }}&w={{ stripWidth }}" alt="" loading="lazy">
    {%- if longEdge > 0 -%}
    {%- if longEdge <= lowResMaxEdge -%}<span class="wti-res is-low" title="Low res · {{ longEdge }} px"></span>
    {%- elsif longEdge < highResMinEdge -%}<span class="wti-res is-mid" title="Medium res · {{ longEdge }} px"></span>
    {%- else -%}<span class="wti-res is-high" title="High res · {{ longEdge }} px"></span>
    {%- endif -%}
    {%- endif -%}
</button>
<button type="button" class="wti-tile-url wti-url-open" title="Build URL" aria-label="Build URL for {{ row.FileName | Escape }}"
        data-guid="{{ row.Guid }}" data-name="{{ row.FileName | Escape }}" data-width="{{ row.Width }}" data-height="{{ row.Height }}"><i class="fa fa-link"></i></button>
</div>
{%- endfor -%}
{%- endcapture -%}

{%- if page == 1 -%}
{%- assign firstRow = results | First -%}
<div class="wti-film">
    <div class="wti-stage">
        <img id="wti-stage-img" src="/GetImage.ashx?guid={{ firstRow.Guid }}&w={{ previewWidth }}" alt="">
        <div class="wti-stage-caption" id="wti-stage-caption">{{ firstRow.FileName | Escape }}</div>
        <div class="wti-stage-tools">
            <button type="button" class="wti-stage-btn wti-url-open" title="Build an image URL"><i class="fa fa-link"></i> Build URL</button>
            <button type="button" class="wti-stage-btn wti-details-toggle" aria-pressed="false" title="Show or hide details"><i class="fa fa-info-circle"></i> Details</button>
        </div>
        <button type="button" class="wti-stage-nav is-prev" data-step="prev" aria-label="Previous image" disabled><i class="fa fa-chevron-left"></i></button>
        <button type="button" class="wti-stage-nav is-next" data-step="next" aria-label="Next image"{% if rowCount < 2 %} disabled{% endif %}><i class="fa fa-chevron-right"></i></button>
    </div>
    <div class="wti-strip" id="wti-strip">
        {{ thumbs }}
        {{ sentinel }}
    </div>
</div>
{%- else -%}
{{ thumbs }}
{{ sentinel }}
{%- endif -%}

{%- else -%}
{%- for row in results limit:pageSize -%}
{%- assign longEdge = row.LongEdge | AsInteger | Default:0 -%}
<div class="wti-card-wrap">
<button type="button" class="wti-card"
        hx-get="^/web-theme-images/detail?guid={{ row.Guid }}"
        hx-target="#wti-detail">
    <img src="/GetImage.ashx?guid={{ row.Guid }}&w={{ thumbWidth }}"
         alt="{{ row.Description | Default:row.FileName | Escape }}"
         loading="lazy"
         {%- if row.Width and row.Height %} width="{{ row.Width }}" height="{{ row.Height }}"{% endif %}>
    {%- if longEdge > 0 -%}
    {%- if longEdge <= lowResMaxEdge -%}<span class="wti-res is-low" title="Low res · {{ longEdge }} px"></span>
    {%- elsif longEdge < highResMinEdge -%}<span class="wti-res is-mid" title="Medium res · {{ longEdge }} px"></span>
    {%- else -%}<span class="wti-res is-high" title="High res · {{ longEdge }} px"></span>
    {%- endif -%}
    {%- endif -%}
    <span class="wti-card-name">{{ row.FileName | Escape }}</span>
    {%- if deleted -%}<span class="wti-card-deleted"><i class="fa fa-trash"></i> Deleted {{ row.ModifiedDateTime | Date:'MMM d, h:mm tt' }}</span>{%- endif -%}
</button>
<button type="button" class="wti-tile-url wti-url-open" title="Build URL" aria-label="Build URL for {{ row.FileName | Escape }}"
        data-guid="{{ row.Guid }}" data-name="{{ row.FileName | Escape }}" data-width="{{ row.Width }}" data-height="{{ row.Height }}"><i class="fa fa-link"></i></button>
</div>
{%- endfor -%}
{{ sentinel }}
{%- endif -%}